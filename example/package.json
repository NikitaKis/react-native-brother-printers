{
  "name": "react-native-brother-printers-example",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "export NODE_BINARY=\"$(command -v node)\" && export PATH=\"$(dirname \"$NODE_BINARY\"):$PATH\" && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-view-shot": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
